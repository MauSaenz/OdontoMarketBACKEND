# ==============================================================================
# VARIABLES DE ENTORNO (.env) - ODONTOMARKET BACKEND
# ==============================================================================

# Nombre del proyecto que aparecerá en la documentación automática Swagger (/docs)
PROJECT_NAME="OdontoMarket API - Marketplace Dental Multi-Vendedor"
VERSION="1.0.0"

# Conexión a Base de Datos:
# En desarrollo local usamos SQLite (crea el archivo odontomarket.db automáticamente).
# Para migrar a PostgreSQL en producción, basta con cambiar esta línea a:
# DATABASE_URL="postgresql+psycopg://usuario:password@localhost:5432/odontomarket"
DATABASE_URL="sqlite:///./odontomarket.db"

# Seguridad JWT (JSON Web Tokens)
# En producción se genera con: openssl rand -hex 32
SECRET_KEY="odontomarket_super_secret_jwt_key_change_in_production_2026_dental"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Orígenes permitidos por CORS (Frontend en Next.js corriendo en el puerto 3000)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
